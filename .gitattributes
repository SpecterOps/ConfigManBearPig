# Generated by `gtk list` and regenerated on every ticket update, with lines up to
# ~3,500 characters. Never merge it -- keep whatever this side has and let the next
# regeneration settle the difference.
#
# NOTE: this attribute alone does nothing. `ours` is not one of git's built-in merge
# drivers (those are text, binary and union), so every clone that will merge this repo
# also needs, once:
#
#     git config merge.ours.driver true
#
# .git/config is not a committable file, which is why the requirement is written here.
TICKETS-BY-STATUS.md merge=ours
